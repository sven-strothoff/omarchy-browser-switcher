#!/usr/bin/env python3
"""browser-switcher — route opened URLs to a chosen browser or browser profile.

The design in one paragraph: a single *router* desktop entry
(`browser-switcher.desktop`) is registered once as the system's default web
browser. Every http(s) link therefore lands in `browser-switcher open`, which
reads one small state file and re-launches the URL in whichever target is
currently selected. Switching browsers is then a one-line write, not a
rewrite of mimeapps.list, so it is instant and nothing races with it.

Everything this program generates is namespaced with a `browser-switcher-`
prefix and carries a GENERATED banner, and nothing it did not create is ever
written or deleted. It assumes nothing about the machine beyond a stock
Omarchy install: it creates its own browser data directories, generates its
own desktop entries and icons, and drops its Hyprland rules into the
directory Omarchy already auto-loads generated Lua from, so no existing
config file has to be edited for any of it to work.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

APP = "browser-switcher"
GENERATED_BANNER = "Generated by browser-switcher. Do not edit; your changes will be overwritten."
ICON_SIZES = (16, 24, 32, 48, 64, 128, 256)


# --------------------------------------------------------------------------- paths

def _xdg(var, default):
    value = os.environ.get(var)
    return value if value else os.path.expanduser(default)


HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), APP)
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
STATE_DIR = os.path.join(_xdg("XDG_STATE_HOME", "~/.local/state"), APP)
STATE_FILE = os.path.join(STATE_DIR, "active")
DATA_DIR = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), APP)
BADGE_DIR = os.path.join(DATA_DIR, "badges")
# Plugin-owned and browser-agnostic: Firefox targets live here too, and a
# purge knows every directory it is allowed to delete.
PROFILE_ROOT = os.path.join(DATA_DIR, "profiles")
APPS_DIR = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), "applications")
ICON_ROOT = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), "icons", "hicolor")
# Honours XDG_BIN_HOME where it is set. That is partly convention and mostly
# so this path can be redirected like every other one here: keyed on HOME
# alone, a run pointed at a throwaway config could still reach — and remove —
# the real symlink in ~/.local/bin.
BIN_DIR = _xdg("XDG_BIN_HOME", "~/.local/bin")
HYPR_DIR = os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), "hypr")
HYPR_MAIN = os.path.join(HYPR_DIR, "hyprland.lua")
# Omarchy's stock hyprland.lua ends with `require("default.hypr.toggles")`,
# which require_all's every *.lua in this directory on each reload. Dropping
# our rules here means a clean install needs no edit to any config file, and
# uninstalling is a single unlink. It also loads after the user's own
# hypr.* modules, so our border colours win — which is what we want, since
# rules are evaluated top to bottom and the last match applies.
HYPR_RULES_DIR = os.path.join(_xdg("XDG_STATE_HOME", "~/.local/state"),
                              "omarchy", "toggles", "hypr")
HYPR_RULES = os.path.join(HYPR_RULES_DIR, "browser-switcher.lua")
ROUTER_DESKTOP = os.path.join(APPS_DIR, "browser-switcher.desktop")


# --------------------------------------------------------------------------- browsers

# How to launch each supported browser with a fully isolated profile.
# `{profile}` and `{class}` are substituted per target. Chromium-family
# browsers get a separate --user-data-dir (a real sandbox: separate cookies,
# separate keyring entry, separate process), not a --profile-directory, which
# shares far too much between "profiles".
# The set Omarchy can install (`omarchy install browser <...>`) plus the
# preinstalled Chromium, and the two extras Omarchy's own window rules already
# recognise (Vivaldi, LibreWolf) for anyone who installed them by hand.
#
# `family` decides three things that genuinely differ: how the profile is
# selected, how the window gets a per-profile app_id, and which of Omarchy's
# two parity rules the generated Hyprland rule has to mirror.
BROWSERS = {
    "chromium": {
        "name": "Chromium",
        "commands": ["chromium", "chromium-browser"],
        "icon": "chromium",
        "private": "--incognito",
        "family": "chromium",
    },
    "google-chrome": {
        "name": "Google Chrome",
        "commands": ["google-chrome-stable", "google-chrome"],
        "icon": "google-chrome",
        "private": "--incognito",
        "family": "chromium",
    },
    "brave": {
        "name": "Brave",
        "commands": ["brave", "brave-browser"],
        "icon": "brave",
        "private": "--incognito",
        "private": "--incognito",
        "family": "chromium",
    },
    "brave-origin": {
        "name": "Brave Origin",
        # Binary name not verified against an install; brave-origin-bin is the
        # package Omarchy pulls.
        "commands": ["brave-origin"],
        "icon": "brave",
        "family": "chromium",
    },
    "microsoft-edge": {
        "name": "Microsoft Edge",
        "commands": ["microsoft-edge-stable", "microsoft-edge"],
        "icon": "microsoft-edge",
        "private": "--inprivate",
        "family": "chromium",
    },
    "vivaldi": {
        "name": "Vivaldi",
        "commands": ["vivaldi-stable", "vivaldi"],
        "icon": "vivaldi",
        "private": "--incognito",
        "family": "chromium",
    },
    "firefox": {
        "name": "Firefox",
        "commands": ["firefox"],
        "icon": "firefox",
        "private": "--private-window",
        "family": "firefox",
    },
    "zen": {
        "name": "Zen Browser",
        "commands": ["zen-browser", "zen"],
        "icon": "zen-browser",
        "private": "--private-window",
        "family": "firefox",
    },
    "librewolf": {
        "name": "LibreWolf",
        "commands": ["librewolf"],
        "icon": "librewolf",
        "private": "--private-window",
        "family": "firefox",
    },
}


# The only values an untrusted caller may pass alongside a URL. They are
# recognised, never forwarded: the switch that reaches the browser is the one
# that browser actually uses, taken from its own entry above. Anything else
# beginning with "-" is refused rather than passed along, because the router is
# a registered URL handler and its argv is reachable by whatever can invoke it.
PRIVATE_REQUEST_ALIASES = frozenset({
    "--private", "-private", "--incognito", "--inprivate", "--private-window",
})

# Schemes the router will hand to a browser. `javascript:` and `data:` are left
# out deliberately — they turn a URL handler into script execution in the
# browser's context, and nothing legitimate routes them through here.
SAFE_URL_SCHEMES = frozenset({
    "http", "https", "ftp", "ftps", "mailto", "file", "about",
    "irc", "ircs", "news", "nntp", "webcal", "xmpp", "tel", "sms", "magnet",
})

SCHEME_RE = re.compile(r"^([a-zA-Z][a-zA-Z0-9+.\-]*):")


def validated_operand(value):
    """Return `value` if it is something we are willing to hand a browser.

    Operands arriving at `open` come from whatever invoked the desktop handler,
    so they are treated strictly as URLs: never as options, and never with a
    scheme that would let the browser execute the payload.
    """
    text = str(value)
    if text.startswith("-"):
        die(f"refusing to treat {text!r} as a URL: options are not accepted here")
    match = SCHEME_RE.match(text)
    if match:
        scheme = match.group(1).lower()
        if scheme not in SAFE_URL_SCHEMES:
            die(f"refusing to open a {scheme}: URL")
    return text


def classify_open_arguments(values):
    """Split an untrusted `open` invocation into (private, urls).

    A narrow allowlist rather than a pass-through: the only recognised option
    is a request for a private window, and it is translated per browser rather
    than forwarded as written.
    """
    private = False
    urls = []
    for value in values:
        if value in PRIVATE_REQUEST_ALIASES:
            private = True
        elif value.startswith("-"):
            die(f"unsupported option {value!r}; `open` accepts URLs and "
                f"a private-window request only")
        else:
            urls.append(validated_operand(value))
    return private, urls


def browser_binary(key):
    spec = BROWSERS.get(key)
    if not spec:
        return None
    for candidate in spec["commands"]:
        found = shutil.which(candidate)
        if found:
            return found
    return None


def installed_browsers():
    out = []
    for key, spec in BROWSERS.items():
        binary = browser_binary(key)
        if binary:
            out.append({"id": key, "name": spec["name"], "binary": binary, "family": spec["family"]})
    out.sort(key=lambda b: b["name"].lower())
    return out


def launch_argv(target, urls, new_window, private=False):
    """Build (argv, env) that opens `urls` in `target`.

    The two families set the window's app_id differently, and both paths below
    were verified against a live Hyprland rather than inferred.

    Chromium takes `--class=NAME`, which on Wayland becomes the app_id (probe
    window reported class=NAME, xwayland=False), and treats each
    `--user-data-dir` as its own singleton.

    Firefox ignores `--class` on Wayland — it only ever set the X11 WM_CLASS.
    Tested with Zen: launching with `--class=zen-probe-class` still produced
    app_id "zen". The app_id comes from MOZ_APP_REMOTINGNAME instead, which
    does work (same test produced "zen-acme"). Without it every Firefox-family
    profile would share one app_id, so no per-profile border colour could match
    and StartupWMClass would be wrong for all of them.

    Isolation itself comes from `--profile`, not from the remoting name:
    two different profile directories run as independent instances even when
    they share a remoting name. So the remoting name is about window identity,
    not about keeping sessions apart.

    Opening a link deliberately omits --new-window so the profile's existing
    window is reused — confirmed: relaunching a running profile with a URL
    hands it to that instance and spawns no new process.
    """
    key = target.get("browser", "chromium")
    spec = BROWSERS.get(key, BROWSERS["chromium"])
    binary = browser_binary(key)
    if not binary:
        die(f"browser {key!r} is configured for target {target['id']!r} but is not installed")

    argv = [binary]
    env = {}

    # A system browser is launched exactly as the system would launch it: its
    # own default profile, its own app_id, no flags of ours.
    if not is_profile(target):
        if new_window:
            argv.append("--new-window")
        if private:
            argv.append(spec["private"])
        argv += operand_arguments(urls)
        return argv, env

    profile = target.get("profileDir") or ""
    wm_class = target.get("wmClass") or f"{key}-{target['id']}"

    if spec["family"] == "chromium":
        if profile:
            argv.append(f"--user-data-dir={profile}")
        argv.append(f"--class={wm_class}")
    else:
        env["MOZ_APP_REMOTINGNAME"] = wm_class
        if profile:
            argv += ["--profile", profile]

    if new_window:
        argv.append("--new-window")
    if private:
        argv.append(spec["private"])

    argv += operand_arguments(urls)
    return argv, env


def operand_arguments(urls):
    """URLs, behind an end-of-options delimiter.

    Both families accept `--` and stop parsing options at it (verified against
    Chromium and Zen), so even a URL that begins with a dash cannot be read as
    a switch. Belt and braces: validated_operand() already refuses those.
    """
    operands = [validated_operand(u) for u in urls]
    return (["--"] + operands) if operands else []


def exec_browser(argv, env):
    """Replace this process with the browser, carrying any env overrides."""
    if env:
        os.environ.update(env)
    os.execv(argv[0], argv)


# --------------------------------------------------------------------------- config

KIND_PROFILE = "profile"
KIND_BROWSER = "browser"


def default_config():
    return {"version": 1, "targets": []}


def load_config():
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return default_config()
    except (OSError, ValueError) as exc:
        die(f"cannot read {CONFIG_FILE}: {exc}")
    if not isinstance(data, dict):
        die(f"{CONFIG_FILE} is not a JSON object")
    data.setdefault("version", 1)
    if not isinstance(data.get("targets"), list):
        data["targets"] = []
    # "client" was the old name for a profile. Rewrite it in memory so the rest
    # of the program only ever sees one spelling; the next save persists it.
    for target in data["targets"]:
        if isinstance(target, dict):
            target["kind"] = KIND_BROWSER if str(
                target.get("kind", KIND_PROFILE)) == KIND_BROWSER else KIND_PROFILE
    return data


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    write_atomic(CONFIG_FILE, json.dumps(cfg, indent=2) + "\n")


def write_atomic(path, content):
    """Write via a temp file in the same directory, then rename.

    The config file is watched by the running shell plugin; a partial read of
    a half-written file would blank the panel, so the swap has to be atomic.
    """
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".bs-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def is_profile(target):
    """Profile targets own an isolated browser directory; browsers are plain.

    A system browser entry exists only so the switcher can point links back at
    an ordinary browser install. It has no directory of its own, no custom
    window class, no generated desktop entry and no badged icon — so every
    generator skips it and it can't be given a colour or logo.

    Anything that is not explicitly "browser" counts as a profile, which is
    also how configs written by earlier versions (kind: "client") keep working.
    """
    return str(target.get("kind", KIND_PROFILE)) != KIND_BROWSER


def find_target(cfg, ident):
    ident = str(ident)
    for t in cfg["targets"]:
        if t["id"] == ident:
            return t
    matches = [t for t in cfg["targets"] if t.get("name", "").lower() == ident.lower()]
    if len(matches) == 1:
        return matches[0]
    return None


def require_target(cfg, ident):
    target = find_target(cfg, ident)
    if not target:
        die(f"no such target: {ident!r} (see `{APP} list`)")
    return target


def slugify(name):
    slug = re.sub(r"[^a-z0-9]+", "-", str(name).strip().lower()).strip("-")
    return slug or "target"


def unique_id(cfg, base):
    existing = {t["id"] for t in cfg["targets"]}
    if base not in existing:
        return base
    n = 2
    while f"{base}-{n}" in existing:
        n += 1
    return f"{base}-{n}"


# --------------------------------------------------------------------------- state

def active_id():
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def set_active(target_id):
    os.makedirs(STATE_DIR, exist_ok=True)
    write_atomic(STATE_FILE, str(target_id) + "\n")


def active_target(cfg):
    ident = active_id()
    if ident:
        found = find_target(cfg, ident)
        if found:
            return found
    return cfg["targets"][0] if cfg["targets"] else None


# --------------------------------------------------------------------------- colors

def norm_color(value, fallback="#8C8FA1"):
    s = str(value or "").strip()
    m = re.match(r"^#?([0-9A-Fa-f]{6})$", s)
    if m:
        return "#" + m.group(1).upper()
    m = re.match(r"^#?([0-9A-Fa-f]{3})$", s)
    if m:
        h = m.group(1)
        return "#" + "".join(c * 2 for c in h).upper()
    # zenity --color-selection hands back rgb(r,g,b) or rgba(...)
    m = re.match(r"^rgba?\((\d+),\s*(\d+),\s*(\d+)", s)
    if m:
        return "#" + "".join(f"{min(255, int(g)):02X}" for g in m.groups())
    return fallback


def hex_digits(color):
    return norm_color(color).lstrip("#")


def dim_hex(color, factor=0.55):
    h = hex_digits(color)
    parts = [int(h[i:i + 2], 16) for i in (0, 2, 4)]
    return "".join(f"{max(0, min(255, int(round(p * factor)))):02X}" for p in parts)


# --------------------------------------------------------------------------- icons

def base_icon_path(browser_key, size):
    """Find the browser's stock icon at `size`, else the biggest one there is."""
    spec = BROWSERS.get(browser_key, BROWSERS["chromium"])
    names = [spec["icon"], browser_key]
    roots = [
        ICON_ROOT,
        "/usr/share/icons/hicolor",
        "/usr/local/share/icons/hicolor",
    ]
    exact, fallbacks = None, []
    for root in roots:
        for name in names:
            for candidate_size in sorted(ICON_SIZES, reverse=True):
                p = os.path.join(root, f"{candidate_size}x{candidate_size}", "apps", f"{name}.png")
                if os.path.isfile(p):
                    if candidate_size == size and exact is None:
                        exact = p
                    fallbacks.append(p)
            svg = os.path.join(root, "scalable", "apps", f"{name}.svg")
            if os.path.isfile(svg):
                fallbacks.append(svg)
    if exact:
        return exact
    for p in ["/usr/share/pixmaps/%s.png" % n for n in names]:
        if os.path.isfile(p):
            fallbacks.append(p)
    return fallbacks[0] if fallbacks else None


def have_magick():
    return shutil.which("magick") or shutil.which("convert")


def magick_argv():
    exe = shutil.which("magick")
    return [exe] if exe else [shutil.which("convert")]


def render_icon(browser_key, badge_png, color, size, out_path):
    """Composite `badge_png` (or a plain colour dot) onto the browser icon.

    The badge is drawn on a filled disc in the profile colour, so a target is
    identifiable at 16px even when its logo is illegible at that size, and so
    a target with no logo at all still gets a distinct mark.
    """
    base = base_icon_path(browser_key, size)
    if not base:
        return False

    disc = max(10, int(round(size * 0.55)))
    ring = max(1, int(round(disc * 0.10)))
    inner = max(4, disc - 2 * ring)
    radius = disc / 2.0
    color = norm_color(color)

    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        disc_png = os.path.join(tmp, "disc.png")
        # Filled circle in the profile colour = the badge backing plate.
        run_quiet(magick_argv() + [
            "-size", f"{disc}x{disc}", "xc:none",
            "-fill", color, "-draw", f"circle {radius},{radius} {radius},0",
            disc_png,
        ])

        if badge_png and os.path.isfile(badge_png):
            run_quiet(magick_argv() + [
                disc_png,
                "(", badge_png, "-background", "none",
                "-resize", f"{inner}x{inner}",
                "-gravity", "center", "-extent", f"{inner}x{inner}", ")",
                "-gravity", "center", "-compose", "over", "-composite",
                disc_png,
            ])

        return run_quiet(magick_argv() + [
            base, "-background", "none",
            "-resize", f"{size}x{size}",
            "-gravity", "center", "-extent", f"{size}x{size}",
            disc_png, "-gravity", "southeast", "-geometry", "+0+0",
            "-compose", "over", "-composite",
            out_path,
        ])


def run_quiet(argv):
    try:
        proc = subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except OSError as exc:
        warn(f"failed to run {argv[0]}: {exc}")
        return False
    if proc.returncode != 0:
        warn(f"{argv[0]} failed: {proc.stderr.decode('utf-8', 'replace').strip()}")
        return False
    return True


def resolve_icon_path(target):
    """Absolute path to the best icon file for a target, for the shell panel.

    QML draws a file, not an icon-theme name, so the lookup that a desktop
    environment would normally do has to happen here.
    """
    if is_profile(target):
        name = icon_name(target)
    else:
        name = BROWSERS.get(target.get("browser", "chromium"),
                            BROWSERS["chromium"])["icon"]

    if os.path.isabs(name) and os.path.isfile(name):
        return name

    roots = [ICON_ROOT, "/usr/share/icons/hicolor", "/usr/local/share/icons/hicolor"]
    for root in roots:
        for size in sorted(ICON_SIZES, reverse=True):
            candidate = os.path.join(root, f"{size}x{size}", "apps", f"{name}.png")
            if os.path.isfile(candidate):
                return candidate
        svg = os.path.join(root, "scalable", "apps", f"{name}.svg")
        if os.path.isfile(svg):
            return svg
    pixmap = f"/usr/share/pixmaps/{name}.png"
    return pixmap if os.path.isfile(pixmap) else ""


def icon_name(target):
    return f"browser-switcher-{target['id']}"


def desktop_filename(target):
    return f"browser-switcher-{target['id']}.desktop"


# --------------------------------------------------------------------------- generation

def generate_icons(target):
    if not have_magick():
        warn("ImageMagick not found — skipping icon badging (install `imagemagick`)")
        return False
    name = icon_name(target)
    ok = False
    for size in ICON_SIZES:
        out = os.path.join(ICON_ROOT, f"{size}x{size}", "apps", f"{name}.png")
        if render_icon(target.get("browser", "chromium"), target.get("badge"), target.get("color"), size, out):
            ok = True
    return ok


def self_path():
    """The path to write into generated Exec= lines.

    Prefer the stable ~/.local/bin entry over whatever path this process
    happens to have been started from, so entries keep working if the git
    checkout is later moved or renamed.
    """
    installed = os.path.join(HOME, ".local", "bin", APP)
    if os.path.isfile(installed):
        return installed
    return shutil.which(APP) or os.path.abspath(sys.argv[0])


def generate_desktop(target):
    key = target.get("browser", "chromium")
    spec = BROWSERS.get(key, BROWSERS["chromium"])
    icon = icon_name(target) if icon_exists(icon_name(target)) else spec["icon"]
    body = f"""[Desktop Entry]
# {GENERATED_BANNER}
Type=Application
Version=1.0
Name={spec['name']} — {target['name']}
GenericName=Web Browser
Comment={spec['name']} in the isolated {target['name']} profile
Exec={shlex.quote(self_path())} launch {shlex.quote(target['id'])} %U
Icon={icon}
Terminal=false
StartupNotify=true
StartupWMClass={target.get('wmClass', key + '-' + target['id'])}
Categories=Network;WebBrowser;
Keywords={key};browser;profile;{target['id']};
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
"""
    write_atomic(os.path.join(APPS_DIR, desktop_filename(target)), body)


def icon_exists(name):
    return any(
        os.path.isfile(os.path.join(ICON_ROOT, f"{s}x{s}", "apps", f"{name}.png"))
        for s in ICON_SIZES
    )


def generate_router_desktop():
    body = f"""[Desktop Entry]
# {GENERATED_BANNER}
Type=Application
Version=1.0
Name=Browser Switcher
GenericName=Web Browser
Comment=Opens links in whichever browser profile is currently selected
Exec={shlex.quote(self_path())} open %U
Icon=browser-switcher
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
"""
    write_atomic(ROUTER_DESKTOP, body)


SAFE_CLASS_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def lua_regex_class(wm_class):
    r"""Return `wm_class` as a regex fragment safe inside a Lua string, or None.

    Two constraints stack here. Hyprland matches classes with a POSIX regex,
    but the pattern is written inside a Lua string literal, and Lua rejects
    unknown escapes like `\-` outright — a backslash-escaped pattern would
    make the whole config fail to parse. So instead of escaping, we restrict
    to characters that need no escaping and express `.` as the bracket class
    `[.]`, which is literal in regex and backslash-free in Lua.
    """
    value = str(wm_class or "")
    if not SAFE_CLASS_RE.match(value):
        return None
    return value.replace(".", "[.]")


def sanitize_wm_class(value):
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", str(value or "")).strip("-")
    return cleaned or "browser"


def generate_hypr_rules(cfg):
    """Emit Hyprland window rules for every configured target.

    Written into Omarchy's auto-required generated-Lua directory, so this
    takes effect on the next `hyprctl reload` without any config file
    referencing it.
    """
    lines = [
        f"-- {GENERATED_BANNER}",
        "--",
        "-- Each profile's windows get that profile's brand colour as the",
        "-- window border, so which session a window belongs to is obvious",
        "-- without reading the tab strip.",
        "",
    ]

    rules = [t for t in cfg["targets"] if is_profile(t) and t.get("wmClass")]

    safe = []
    for t in rules:
        if lua_regex_class(t["wmClass"]):
            safe.append(t)
        else:
            warn(f"skipping Hyprland rule for {t['id']}: window class "
                 f"{t['wmClass']!r} has characters that cannot be embedded safely")
    rules = safe

    if not rules:
        lines.append("-- No targets configured yet.")
        write_atomic(HYPR_RULES, "\n".join(lines) + "\n")
        return

    # Parity with Omarchy's own browser rules. Its match:class patterns are
    # full-match regexes, so a custom per-profile app_id like "chromium-acme"
    # misses them and would keep the generic default-opacity treatment. We
    # re-apply the right one per family -- and they are not the same rule:
    # chromium-based browsers get tile=true, firefox-based ones do not.
    families = {
        "chromium": {
            "label": "chromium-based",
            "body": ['  tag = "-default-opacity",', "  tile = true,",
                     '  opacity = "1.0 0.985",'],
        },
        "firefox": {
            "label": "firefox-based",
            "body": ['  tag = "-default-opacity",', '  opacity = "1.0 0.985",'],
        },
    }

    lines += [
        "-- Omarchy's browser rules match on a full-match regex, so these custom",
        "-- per-profile classes miss them. Re-apply each family's treatment, which",
        "-- differs: chromium-based browsers tile, firefox-based ones do not.",
    ]
    for family, spec in families.items():
        members = [t for t in rules
                   if BROWSERS.get(t.get("browser", "chromium"),
                                   BROWSERS["chromium"])["family"] == family]
        if not members:
            continue
        classes = "|".join(lua_regex_class(t["wmClass"]) for t in members)
        lines.append(f'-- {spec["label"]}')
        lines.append(f'o.window("({classes})", {{')
        lines += spec["body"]
        lines.append("})")
        lines.append("")

    lines += [
        "-- Profile identity colours: active border, then a dimmed inactive one",
        "-- so an unfocused window still shows which profile it belongs to.",
    ]
    for t in rules:
        active = hex_digits(t.get("color"))
        inactive = dim_hex(t.get("color"))
        lines.append(
            f'o.window("{t["wmClass"]}", {{ border_color = "rgb({active}) rgb({inactive})" }})'
        )

    write_atomic(HYPR_RULES, "\n".join(lines) + "\n")


def reload_hyprland():
    """Ask Hyprland to re-read its config so new rules apply to new windows.

    Silent when Hyprland is not running (a headless install, or configuring
    from a TTY) — the rules are on disk either way and load on next start.
    """
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    exe = shutil.which("hyprctl")
    if exe:
        run_quiet([exe, "reload"])


def refresh_desktop_database():
    if shutil.which("update-desktop-database"):
        run_quiet([shutil.which("update-desktop-database"), APPS_DIR])
    # Skip the icon cache unless the theme dir is a real one; gtk-update-icon-cache
    # errors out on a bare directory with no index.theme, which is only noise.
    if shutil.which("gtk-update-icon-cache") and os.path.isfile(os.path.join(ICON_ROOT, "index.theme")):
        run_quiet([shutil.which("gtk-update-icon-cache"), "-f", "-t", ICON_ROOT])


def apply_all(cfg, quiet=False):
    generate_router_desktop()
    for target in cfg["targets"]:
        if is_profile(target):
            generate_icons(target)
            generate_desktop(target)
    generate_hypr_rules(cfg)
    reload_hyprland()
    refresh_desktop_database()
    if not quiet:
        info(f"applied {len(cfg['targets'])} target(s)")


# --------------------------------------------------------------------------- output

def die(msg, code=1):
    print(f"{APP}: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"{APP}: warning: {msg}", file=sys.stderr)


def info(msg):
    print(f"{APP}: {msg}")


def notify(title, body, icon=None):
    """Desktop notification. `icon` is a path; a missing one is dropped.

    Passing a name the icon theme cannot resolve makes the notification daemon
    draw its missing-image placeholder — the pink-and-black checkerboard — which
    looks far more broken than simply having no icon.
    """
    exe = shutil.which("notify-send")
    if not exe:
        return
    argv = [exe, "-a", "Browser Switcher"]
    if icon and os.path.isfile(icon):
        argv += ["-i", icon]
    argv += [title, body]
    subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --------------------------------------------------------------------------- commands

def cmd_open(args):
    cfg = load_config()
    target = active_target(cfg)
    if not target:
        # Never swallow a link: with nothing configured, fall through to a
        # real browser rather than dropping the URL on the floor.
        for key in ("chromium", "firefox", "google-chrome", "brave"):
            binary = browser_binary(key)
            if binary:
                warn("no targets configured — falling back to " + key)
                spec = BROWSERS[key]
                fallback = [binary]
                if getattr(args, "private", False):
                    fallback.append(spec["private"])
                fallback += operand_arguments(args.urls)
                os.execv(binary, fallback)
        die("no targets configured and no browser found")
    argv, env = launch_argv(target, args.urls, new_window=False,
                            private=getattr(args, "private", False))
    exec_browser(argv, env)


def cmd_launch(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    argv, env = launch_argv(target, args.urls, new_window=True)
    exec_browser(argv, env)


def cmd_use(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    set_active(target["id"])
    if not args.quiet:
        info(f"links now open in {target['name']}")
    if args.notify:
        # resolve_icon_path covers both kinds: the generated badge for a
        # profile, the browser's own stock icon for a system browser.
        notify("Browser switched", f"Links now open in {target['name']}",
               resolve_icon_path(target))


def cmd_status(args):
    cfg = load_config()
    target = active_target(cfg)
    if args.json:
        print(json.dumps({
            "active": target["id"] if target else None,
            "activeName": target["name"] if target else None,
            "installed": os.path.isfile(ROUTER_DESKTOP),
            "isDefault": is_default_browser(),
        }, indent=2))
        return
    if not target:
        print("no targets configured")
        return
    print(f"{target['name']} ({target['id']})")


def cmd_list(args):
    cfg = load_config()
    current = active_target(cfg)
    if args.json:
        enriched = []
        for t in cfg["targets"]:
            row = dict(t)
            row["kind"] = KIND_PROFILE if is_profile(t) else KIND_BROWSER
            icon = resolve_icon_path(t)
            row["iconPath"] = icon
            # The icon keeps one stable filename for its whole life, so the
            # panel's Image would happily serve a cached pixmap after a
            # re-badge. Hand it a version it can use to bust that cache.
            try:
                row["iconVersion"] = int(os.path.getmtime(icon)) if icon else 0
            except OSError:
                row["iconVersion"] = 0
            row["available"] = bool(browser_binary(t.get("browser", "chromium")))
            enriched.append(row)
        print(json.dumps({
            "active": current["id"] if current else None,
            "targets": enriched,
            "browsers": installed_browsers(),
            "installed": os.path.isfile(ROUTER_DESKTOP),
            "isDefault": is_default_browser(),
        }, indent=2))
        return
    if not cfg["targets"]:
        print("Nothing configured yet.")
        print("  browser-switcher add --name NAME     an isolated profile")
        print("  browser-switcher add-browser NAME    a browser as itself")
        return

    profiles = [t for t in cfg["targets"] if is_profile(t)]
    systems = [t for t in cfg["targets"] if not is_profile(t)]

    def label(target):
        # The id is derived from the name, so for most entries the two are the
        # same string and printing both is just noise. Show the id only when it
        # differs and you would therefore need to be told it.
        name = str(target.get("name", target["id"]))
        return name if slugify(name) == target["id"] else f"{name} ({target['id']})"

    width = min(34, max(len(label(t)) for t in cfg["targets"]))

    def render(target):
        active = current and target["id"] == current["id"]
        # An arrow rather than an asterisk: the active entry is where links go,
        # which is a direction, not a footnote.
        mark = "→" if active else " "
        browser = str(target.get("browser", "chromium"))
        line = f"  {mark} {label(target):<{width}}  {browser:<14}"
        if is_profile(target):
            line += f"{swatch(target.get('color'))}"
        if not browser_binary(browser):
            line += "  (not installed)"
        return line.rstrip()

    if profiles:
        print("Profiles" if not systems else "Profiles (isolated)")
        for t in profiles:
            print(render(t))
    if systems:
        if profiles:
            print()
        print("System browsers")
        for t in systems:
            print(render(t))


def swatch(color):
    """The colour itself when a terminal can show it, the hex when it can't."""
    hex_value = norm_color(color)
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return hex_value
    h = hex_value.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"\x1b[38;2;{r};{g};{b}m\u25a0\u25a0\x1b[0m {hex_value}"


def cmd_browsers(args):
    found = installed_browsers()
    if args.json:
        print(json.dumps(found, indent=2))
        return
    for b in found:
        print(f"{b['id']:<16} {b['name']:<18} {b['binary']}")


def cmd_add(args):
    cfg = load_config()
    name = args.name.strip()
    if not name:
        die("--name must not be empty")
    browser = args.browser
    if browser not in BROWSERS:
        die(f"unknown browser {browser!r} (see `{APP} browsers`)")
    if not browser_binary(browser):
        warn(f"{browser} is not installed right now; adding the target anyway")

    target_id = unique_id(cfg, slugify(args.id or name))
    wm_class = sanitize_wm_class(args.wm_class or f"{browser}-{target_id}")

    # Refuse to shadow a hand-made setup. A duplicate WM class would make the
    # user's own window rules and ours both match, and the loser is decided by
    # require order — a confusing failure to debug later.
    clash = existing_wm_class_owner(cfg, wm_class)
    if clash and not args.force:
        die(f"window class {wm_class!r} is already used by {clash}.\n"
            f"  Remove that entry first, or pass --wm-class to pick another class.")

    profile_dir = args.profile_dir or os.path.join(PROFILE_ROOT, target_id)
    badge = None
    if args.icon:
        badge = store_badge(target_id, args.icon)

    target = {
        "id": target_id,
        "name": name,
        "browser": browser,
        "profileDir": profile_dir,
        "wmClass": wm_class,
        "color": norm_color(args.color),
        "badge": badge,
        "kind": KIND_PROFILE,
    }
    cfg["targets"].append(target)
    save_config(cfg)
    os.makedirs(profile_dir, exist_ok=True)
    apply_all(cfg, quiet=True)
    if not active_id():
        set_active(target_id)
    info(f"added {name} ({target_id})")


def cmd_add_browser(args):
    """Register a plain system browser as a switch destination.

    No name, colour or logo to supply: a system browser is whatever is already
    installed, so the entry is just a pointer to it.
    """
    cfg = load_config()
    key = args.browser
    if key not in BROWSERS:
        die(f"unknown browser {key!r} (see `{APP} browsers`)")
    if not browser_binary(key):
        die(f"{key} is not installed")

    for t in cfg["targets"]:
        if not is_profile(t) and t.get("browser") == key:
            die(f"{BROWSERS[key]['name']} is already in the switcher as {t['id']!r}")

    target_id = unique_id(cfg, slugify(key))
    cfg["targets"].append({
        "id": target_id,
        "name": args.name.strip() if args.name else BROWSERS[key]["name"],
        "browser": key,
        "kind": KIND_BROWSER,
    })
    save_config(cfg)
    if not active_id():
        set_active(target_id)
    apply_all(cfg, quiet=True)
    info(f"added {BROWSERS[key]['name']} ({target_id})")


def cmd_addable_browsers(args):
    """Installed browsers that are not already in the switcher as themselves."""
    cfg = load_config()
    taken = {t.get("browser") for t in cfg["targets"] if not is_profile(t)}
    rows = [b for b in installed_browsers() if b["id"] not in taken]
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    for b in rows:
        print(f"{b['id']:<16} {b['name']}")


def existing_wm_class_owner(cfg, wm_class):
    for t in cfg["targets"]:
        if t.get("wmClass") == wm_class:
            return f"target {t['id']!r}"
    # Scan hand-made desktop entries too — this is exactly the collision the
    # user warned about between their manual setup and generated files.
    for directory in (APPS_DIR, "/usr/share/applications"):
        try:
            entries = os.listdir(directory)
        except OSError:
            continue
        for entry in entries:
            if not entry.endswith(".desktop") or entry.startswith("browser-switcher-"):
                continue
            path = os.path.join(directory, entry)
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as fh:
                    content = fh.read()
            except OSError:
                continue
            if re.search(r"^StartupWMClass=%s\s*$" % re.escape(wm_class), content, re.M):
                return f"the existing desktop entry {entry}"
    return None


def store_badge(target_id, source):
    source = os.path.expanduser(source)
    if not os.path.isfile(source):
        die(f"icon file not found: {source}")
    os.makedirs(BADGE_DIR, exist_ok=True)
    dest = os.path.join(BADGE_DIR, f"{target_id}.png")
    if not have_magick():
        shutil.copyfile(source, dest)
        return dest
    # Normalise whatever was handed to us (svg, jpg, huge png) to one square
    # transparent PNG, so re-badging later never has to touch the original.
    if not run_quiet(magick_argv() + [
        source, "-background", "none", "-resize", "256x256",
        "-gravity", "center", "-extent", "256x256", dest,
    ]):
        die(f"could not convert {source} into a badge image")
    return dest


def cmd_remove(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    cfg["targets"] = [t for t in cfg["targets"] if t["id"] != target["id"]]
    save_config(cfg)

    if is_profile(target):
        remove_quiet(os.path.join(APPS_DIR, desktop_filename(target)))
        for size in ICON_SIZES:
            remove_quiet(os.path.join(ICON_ROOT, f"{size}x{size}", "apps", f"{icon_name(target)}.png"))
        remove_quiet(target.get("badge"))

    profile_dir = target.get("profileDir", "")
    if args.purge:
        # Only ever delete inside our own profile root. A --profile-dir pointing
        # somewhere else belongs to the user, not to us — say so rather than
        # silently doing nothing, which is what this used to do.
        if not profile_dir:
            pass
        elif not profile_dir.startswith(PROFILE_ROOT):
            warn(f"not deleting {profile_dir}: it is outside {PROFILE_ROOT}, "
                 f"so it was not created by this program. Remove it by hand if you want it gone.")
        else:
            shutil.rmtree(profile_dir, ignore_errors=True)
            info(f"deleted browsing data at {profile_dir}")
    kept_data = (not args.purge and is_profile(target)
                 and profile_dir and os.path.isdir(profile_dir))

    if active_id() == target["id"]:
        remaining = cfg["targets"]
        if remaining:
            set_active(remaining[0]["id"])
        else:
            remove_quiet(STATE_FILE)

    apply_all(cfg, quiet=True)
    info(f"removed {target['name']} ({target['id']})")
    if kept_data:
        # Keeping the data is the safe default, but silence about it is not:
        # someone removing a profile may well assume its logins and history
        # went with it. Note that --purge is no use now — the target is gone —
        # so point at the directory itself.
        info(f"browsing data kept at {profile_dir}")
        info("that directory holds its logins and history; delete it yourself "
             "if you want it gone")


def remove_quiet(path):
    if not path:
        return
    try:
        os.unlink(path)
    except OSError:
        pass


def cmd_rename(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    new_name = args.new_name.strip()
    if not new_name:
        die("new name must not be empty")
    target["name"] = new_name
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"renamed {target['id']} to {new_name}")


def cmd_set(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    if not is_profile(target) and (args.color or args.icon or args.profile_dir or args.browser):
        die(f"{target['id']!r} is a system browser entry: it has no colour, logo "
            f"or profile of its own. Only --name applies.")
    changed = []
    if args.name:
        target["name"] = args.name.strip()
        changed.append("name")
    if args.color:
        target["color"] = norm_color(args.color)
        changed.append("color")
    if args.icon:
        target["badge"] = store_badge(target["id"], args.icon)
        changed.append("icon")
    if args.browser:
        if args.browser not in BROWSERS:
            die(f"unknown browser {args.browser!r}")
        target["browser"] = args.browser
        changed.append("browser")
    if args.profile_dir:
        target["profileDir"] = os.path.expanduser(args.profile_dir)
        changed.append("profile")
    if not changed:
        die("nothing to change — pass at least one of --name/--color/--icon/--browser/--profile-dir")
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"updated {target['id']}: {', '.join(changed)}")


def cmd_reorder(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    targets = cfg["targets"]
    index = targets.index(target)
    new_index = max(0, min(len(targets) - 1, index + (-1 if args.direction == "up" else 1)))
    targets.insert(new_index, targets.pop(index))
    save_config(cfg)
    info(f"moved {target['id']} {args.direction}")


def cmd_pick_icon(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    if not is_profile(target):
        die(f"{target['id']!r} is a system browser entry and uses the browser's own icon")
    exe = shutil.which("zenity")
    if not exe:
        die("zenity is not installed; pass a path with `set --icon PATH` instead")
    proc = subprocess.run(
        [exe, "--file-selection", "--title", f"Choose a logo for {target['name']}",
         "--file-filter=Images | *.png *.jpg *.jpeg *.svg *.webp *.ico"],
        capture_output=True, text=True)
    path = proc.stdout.strip()
    if proc.returncode != 0 or not path:
        return
    target["badge"] = store_badge(target["id"], path)
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"icon updated for {target['id']}")


def cmd_pick_color(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    if not is_profile(target):
        die(f"{target['id']!r} is a system browser entry and has no border colour")
    exe = shutil.which("zenity")
    if not exe:
        die("zenity is not installed; pass a value with `set --color '#RRGGBB'` instead")
    proc = subprocess.run(
        [exe, "--color-selection", "--show-palette",
         "--title", f"Colour for {target['name']}",
         "--color", norm_color(target.get("color"))],
        capture_output=True, text=True)
    value = proc.stdout.strip()
    if proc.returncode != 0 or not value:
        return
    target["color"] = norm_color(value, target.get("color"))
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"colour updated for {target['id']}")


# --------------------------------------------------------------------------- install

def xdg_env():
    """Environment for xdg-settings, with BROWSER removed.

    `xdg-settings set default-web-browser` refuses outright while $BROWSER is
    set ("$BROWSER is set and can't be changed with xdg-settings"), and Omarchy
    always sets it to omarchy-launch-browser — so every call here would fail on
    a stock system. Omarchy's own scripts strip it the same way for `get`.
    """
    env = dict(os.environ)
    env.pop("BROWSER", None)
    return env


def is_default_browser():
    exe = shutil.which("xdg-settings")
    if not exe:
        return False
    try:
        proc = subprocess.run([exe, "get", "default-web-browser"],
                              capture_output=True, text=True, timeout=10,
                              env=xdg_env())
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.stdout.strip() == "browser-switcher.desktop"


def previous_default_file():
    return os.path.join(STATE_DIR, "previous-default-browser")


def link_into_path():
    """Symlink this script into ~/.local/bin, if nothing is there already.

    A plugin installed with `omarchy plugin add` is only cloned — no install
    script runs — so setup can happen entirely from the panel, and this is what
    gives that user a working `browser-switcher` command in a terminal too. It
    also pins a stable path for generated Exec= lines, which otherwise point
    into the plugin directory and break if the plugin is removed.
    """
    source = os.path.realpath(os.path.abspath(sys.argv[0]))
    dest = os.path.join(BIN_DIR, APP)
    if os.path.realpath(dest) == source:
        return
    if os.path.exists(dest) or os.path.islink(dest):
        warn(f"{dest} already exists; leaving it alone")
        return
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        os.symlink(source, dest)
    except OSError as exc:
        warn(f"could not link {dest}: {exc}")
        return
    info(f"linked {dest} -> {source}")


def cmd_install(args):
    cfg = load_config()
    link_into_path()
    generate_router_desktop()

    if args.set_default:
        exe = shutil.which("xdg-settings")
        if not exe:
            warn("xdg-settings not found — set the default browser manually")
        else:
            current = subprocess.run([exe, "get", "default-web-browser"],
                                     capture_output=True, text=True,
                                     env=xdg_env()).stdout.strip()
            # Remember what was there so `uninstall` can put it back rather
            # than leaving the system with no default browser at all.
            if current and current != "browser-switcher.desktop":
                os.makedirs(STATE_DIR, exist_ok=True)
                write_atomic(previous_default_file(), current + "\n")
            proc = subprocess.run([exe, "set", "default-web-browser", "browser-switcher.desktop"],
                                  capture_output=True, text=True, env=xdg_env())
            if proc.returncode != 0:
                warn(f"could not set default browser: {proc.stderr.strip()}")
            else:
                info("browser-switcher.desktop is now the default web browser")

    apply_all(cfg, quiet=True)
    info("installed")
    if not args.set_default:
        info("run with --set-default to route links here, or set 'Browser Switcher' "
             "as your default browser manually")


def cmd_uninstall(args):
    cfg = load_config()

    if is_default_browser():
        exe = shutil.which("xdg-settings")
        restore = None
        try:
            with open(previous_default_file(), "r", encoding="utf-8") as fh:
                restore = fh.read().strip()
        except OSError:
            pass
        if exe and restore:
            subprocess.run([exe, "set", "default-web-browser", restore],
                           capture_output=True, text=True, env=xdg_env())
            info(f"restored {restore} as the default browser")
        else:
            warn("was the default browser — set a new default manually")

    # Remove the PATH link only when it resolves to the very program running
    # this uninstall. Matching on the name alone would let one copy delete a
    # link belonging to another — and this path is keyed on HOME, so it is not
    # redirected by the XDG_* overrides the rest of the program honours.
    dest = os.path.join(BIN_DIR, APP)
    running = os.path.realpath(os.path.abspath(sys.argv[0]))
    if os.path.islink(dest) and os.path.realpath(dest) == running:
        remove_quiet(dest)
        info(f"removed {dest}")

    remove_quiet(ROUTER_DESKTOP)
    for target in cfg["targets"]:
        if not is_profile(target):
            continue
        remove_quiet(os.path.join(APPS_DIR, desktop_filename(target)))
        for size in ICON_SIZES:
            remove_quiet(os.path.join(ICON_ROOT, f"{size}x{size}", "apps",
                                      f"{icon_name(target)}.png"))
    # Nothing to unwire: the rules file was auto-discovered, never referenced.
    remove_quiet(HYPR_RULES)
    reload_hyprland()
    refresh_desktop_database()
    info("uninstalled — config kept at " + CONFIG_FILE)
    if args.purge:
        shutil.rmtree(CONFIG_DIR, ignore_errors=True)
        shutil.rmtree(DATA_DIR, ignore_errors=True)
        shutil.rmtree(STATE_DIR, ignore_errors=True)
        info("purged configuration and badges")


def cmd_apply(args):
    cfg = load_config()
    # load_config normalises the old kind label; writing it back here means a
    # plain `apply` is enough to migrate a config, rather than waiting for the
    # next edit to happen to touch it.
    save_config(cfg)
    apply_all(cfg)


def cmd_doctor(args):
    cfg = load_config()
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        if not good:
            ok = False
        print(f"  [{'ok' if good else 'FAIL'}] {label}" + (f" — {detail}" if detail else ""))

    print("browser-switcher doctor\n")
    check("ImageMagick available", bool(have_magick()), "needed for badged icons")
    check("router desktop entry installed", os.path.isfile(ROUTER_DESKTOP), ROUTER_DESKTOP)
    check("is the default web browser", is_default_browser(),
          "run `browser-switcher install --set-default`")
    check("targets configured", bool(cfg["targets"]), f"{len(cfg['targets'])} found")

    current = active_target(cfg)
    check("an active target is selected", current is not None,
          current["name"] if current else "none")

    for target in cfg["targets"]:
        binary = browser_binary(target.get("browser", "chromium"))
        check(f"target {target['id']}: browser installed", bool(binary),
              target.get("browser", "chromium"))
        if not is_profile(target):
            continue
        profile = target.get("profileDir")
        if profile:
            check(f"target {target['id']}: profile dir exists", os.path.isdir(profile), profile)
        entry = os.path.join(APPS_DIR, desktop_filename(target))
        check(f"target {target['id']}: desktop entry", os.path.isfile(entry), entry)
        check(f"target {target['id']}: badged icon", icon_exists(icon_name(target)))

    # $BROWSER is consulted directly by plenty of CLI tools, and by xdg-open
    # when no scheme handler matches. Omarchy sets it to omarchy-launch-browser,
    # which defers to xdg-settings and so lands back on us; a value naming one
    # specific browser silently bypasses the switcher for those callers.
    browser_env = os.environ.get("BROWSER", "")
    if browser_env:
        defers = ("omarchy-launch-browser" in browser_env
                  or APP in browser_env)
        check("$BROWSER routes through the switcher", defers,
              "" if defers else f"BROWSER={browser_env} bypasses it for terminal tools")

    check("Hyprland window rules generated", os.path.isfile(HYPR_RULES), HYPR_RULES)
    if os.path.isfile(HYPR_MAIN):
        # The rules only load because Omarchy's stock hyprland.lua requires
        # default.hypr.toggles, which auto-loads this directory. A user who
        # deleted that line gets colourless borders and no other symptom, so
        # name it explicitly rather than leaving them to guess.
        try:
            with open(HYPR_MAIN, "r", encoding="utf-8") as fh:
                wired = "default.hypr.toggles" in fh.read()
        except OSError:
            wired = False
        check("hyprland.lua loads Omarchy's generated-Lua directory", wired,
              "" if wired else 'needs require("default.hypr.toggles")')

    print()
    sys.exit(0 if ok else 1)


# --------------------------------------------------------------------------- cli

# Anything with a scheme, an absolute/relative path, or a bare www host. Used
# only to tell a URL from a mistyped subcommand, so it errs towards strict.
URL_LIKE = re.compile(r"^(?:[a-zA-Z][a-zA-Z0-9+.\-]*:|/|\./|\.\./|~/|www\.)")


def looks_like_url(value):
    return bool(URL_LIKE.match(str(value)))


def build_parser():
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Route opened URLs to a chosen browser or browser profile.")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("open", help="open URLs in the active target (the router)")
    p.add_argument("urls", nargs="*")
    p.add_argument("--private", action="store_true",
                   help="open in a private window")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("launch", help="open a new window of a specific target")
    p.add_argument("target")
    p.add_argument("urls", nargs="*")
    p.add_argument("--private", action="store_true",
                   help="open in a private window")
    p.set_defaults(func=cmd_launch)

    p = sub.add_parser("use", help="make a target the active link destination")
    p.add_argument("target")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--notify", action="store_true", help="show a desktop notification")
    p.set_defaults(func=cmd_use)

    p = sub.add_parser("status", help="show the active target")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("list", help="list configured targets")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("browsers", help="list installed browsers")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_browsers)

    p = sub.add_parser("add", help="create a new isolated profile")
    p.add_argument("--name", required=True)
    p.add_argument("--id", help="explicit slug (default: derived from the name)")
    p.add_argument("--browser", default="chromium")
    p.add_argument("--color", default="#8C8FA1")
    p.add_argument("--icon", help="path to a logo image to badge onto the browser icon")
    p.add_argument("--profile-dir")
    p.add_argument("--wm-class")
    p.add_argument("--force", action="store_true", help="add even if the window class clashes")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("add-browser", help="add a plain system browser as a destination")
    p.add_argument("browser")
    p.add_argument("--name", help="override the display name")
    p.set_defaults(func=cmd_add_browser)

    p = sub.add_parser("addable-browsers",
                       help="installed browsers not yet in the switcher")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_addable_browsers)

    p = sub.add_parser("remove", help="delete a target")
    p.add_argument("target")
    p.add_argument("--purge", action="store_true",
                   help="also delete its browsing data (logins, history) — irreversible")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("rename", help="rename a target")
    p.add_argument("target")
    p.add_argument("new_name")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("set", help="change a target's properties")
    p.add_argument("target")
    p.add_argument("--name")
    p.add_argument("--color")
    p.add_argument("--icon")
    p.add_argument("--browser")
    p.add_argument("--profile-dir")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("reorder", help="move a target up or down the list")
    p.add_argument("target")
    p.add_argument("direction", choices=["up", "down"])
    p.set_defaults(func=cmd_reorder)

    p = sub.add_parser("pick-icon", help="choose a logo with a file dialog")
    p.add_argument("target")
    p.set_defaults(func=cmd_pick_icon)

    p = sub.add_parser("pick-color", help="choose a colour with a colour dialog")
    p.add_argument("target")
    p.set_defaults(func=cmd_pick_color)

    p = sub.add_parser("install", help="install the router and register it")
    p.add_argument("--set-default", action="store_true",
                   help="make browser-switcher the default web browser")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="remove generated files and restore the previous default")
    p.add_argument("--purge", action="store_true", help="also delete config and badges")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("apply", help="regenerate every desktop entry, icon and window rule")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("doctor", help="check the installation")
    p.set_defaults(func=cmd_doctor)

    return parser


def main():
    """Dispatch, treating a bare URL as an implicit `open`.

    Two callers reach us without the `open` subcommand:

    `omarchy-launch-browser` resolves the default browser through
    xdg-settings, then extracts only the *first word* of that entry's Exec
    line — so our `Exec=browser-switcher open %U` becomes plain
    `browser-switcher <url>`, with the subcommand discarded.

    And `$BROWSER` (which Omarchy sets to omarchy-launch-browser) is what
    xdg-open falls back to under Hyprland, since XDG_CURRENT_DESKTOP=Hyprland
    matches no known desktop and xdg-open takes its generic path. That is the
    route a link clicked in the terminal actually travels.

    So a bare URL has to work, or every terminal link and every CLI tool that
    honours $BROWSER breaks.

    What arrives here is untrusted: anything able to invoke the registered
    handler controls this argv. `open` therefore takes URLs and one recognised
    request — a private window, because omarchy-launch-browser rewrites
    `--private` on the way past — and refuses every other option rather than
    letting a caller choose the browser's switches. The request is translated
    per browser rather than forwarded, so the flag that lands is one the target
    actually understands.
    """
    argv = list(sys.argv[1:])

    # No arguments at all means "open the browser". That is how
    # omarchy-launch-browser invokes the default browser when there is no URL
    # to pass — it takes the first word of our Exec line and runs it bare — so
    # this is what Omarchy's own open-browser keybind ends up calling.
    if not argv:
        argv = ["open"]

    commands = set(build_parser()._subparsers._group_actions[0].choices)

    if argv and argv[0] not in commands:
        has_url = any(looks_like_url(a) for a in argv)
        only_flags = all(a.startswith("-") for a in argv)
        # A mistyped subcommand still reaches argparse and gets a proper error.
        if has_url or only_flags:
            argv = ["open"] + argv

    parser = build_parser()

    # The untrusted path does not go through parse_known_args, which would put
    # caller-controlled strings back into the argv we build for the browser.
    wants_help = any(a in ("-h", "--help") for a in argv[1:])
    if argv and argv[0] == "open" and not wants_help:
        private, urls = classify_open_arguments(argv[1:])
        args = argparse.Namespace(func=cmd_open, urls=urls, private=private)
    else:
        args = parser.parse_args(argv)
        if not hasattr(args, "private"):
            args.private = False
    args.func(args)


if __name__ == "__main__":
    main()
