#!/usr/bin/env python3
"""browser-switcher — route opened URLs to a chosen browser / client profile.

The design in one paragraph: a single *router* desktop entry
(`browser-switcher.desktop`) is registered once as the system's default web
browser. Every http(s) link therefore lands in `browser-switcher open`, which
reads one small state file and re-launches the URL in whichever target is
currently selected. Switching browsers is then a one-line write, not a
rewrite of mimeapps.list, so it is instant and nothing races with it.

Everything this program generates is namespaced with a `browser-switcher-`
prefix and carries a GENERATED banner. Files it did not create are never
written or deleted: hand-made setups are brought in with `adopt`, which
records them as unmanaged and leaves them strictly alone.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

APP = "browser-switcher"
GENERATED_BANNER = "Generated by browser-switcher. Do not edit; your changes will be overwritten."
ICON_SIZES = (16, 24, 32, 48, 64, 128, 256)


# --------------------------------------------------------------------------- paths

def _xdg(var, default):
    value = os.environ.get(var)
    return value if value else os.path.expanduser(default)


HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), APP)
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
STATE_DIR = os.path.join(_xdg("XDG_STATE_HOME", "~/.local/state"), APP)
STATE_FILE = os.path.join(STATE_DIR, "active")
DATA_DIR = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), APP)
BADGE_DIR = os.path.join(DATA_DIR, "badges")
PROFILE_ROOT = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), "chromium-profiles")
APPS_DIR = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), "applications")
ICON_ROOT = os.path.join(_xdg("XDG_DATA_HOME", "~/.local/share"), "icons", "hicolor")
HYPR_DIR = os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), "hypr")
HYPR_RULES = os.path.join(HYPR_DIR, "browser-switcher.lua")
HYPR_MAIN = os.path.join(HYPR_DIR, "hyprland.lua")
ROUTER_DESKTOP = os.path.join(APPS_DIR, "browser-switcher.desktop")
HYPR_REQUIRE = 'require("hypr.browser-switcher")'


# --------------------------------------------------------------------------- browsers

# How to launch each supported browser with a fully isolated profile.
# `{profile}` and `{class}` are substituted per target. Chromium-family
# browsers get a separate --user-data-dir (a real sandbox: separate cookies,
# separate keyring entry, separate process), not a --profile-directory, which
# shares far too much between "profiles".
BROWSERS = {
    "chromium": {
        "name": "Chromium",
        "commands": ["chromium", "chromium-browser"],
        "icon": "chromium",
        "family": "chromium",
    },
    "google-chrome": {
        "name": "Google Chrome",
        "commands": ["google-chrome-stable", "google-chrome"],
        "icon": "google-chrome",
        "family": "chromium",
    },
    "brave": {
        "name": "Brave",
        "commands": ["brave", "brave-browser"],
        "icon": "brave",
        "family": "chromium",
    },
    "vivaldi": {
        "name": "Vivaldi",
        "commands": ["vivaldi-stable", "vivaldi"],
        "icon": "vivaldi",
        "family": "chromium",
    },
    "microsoft-edge": {
        "name": "Microsoft Edge",
        "commands": ["microsoft-edge-stable", "microsoft-edge"],
        "icon": "microsoft-edge",
        "family": "chromium",
    },
    "firefox": {
        "name": "Firefox",
        "commands": ["firefox"],
        "icon": "firefox",
        "family": "firefox",
    },
    "librewolf": {
        "name": "LibreWolf",
        "commands": ["librewolf"],
        "icon": "librewolf",
        "family": "firefox",
    },
    "zen": {
        "name": "Zen Browser",
        "commands": ["zen-browser", "zen"],
        "icon": "zen-browser",
        "family": "firefox",
    },
}


def browser_binary(key):
    spec = BROWSERS.get(key)
    if not spec:
        return None
    for candidate in spec["commands"]:
        found = shutil.which(candidate)
        if found:
            return found
    return None


def installed_browsers():
    out = []
    for key, spec in BROWSERS.items():
        binary = browser_binary(key)
        if binary:
            out.append({"id": key, "name": spec["name"], "binary": binary, "family": spec["family"]})
    out.sort(key=lambda b: b["name"].lower())
    return out


def launch_argv(target, urls, new_window):
    """Build the argv that opens `urls` in `target`.

    Note the asymmetry: opening a *link* deliberately omits --new-window so
    Chromium reuses the profile's running window (its singleton is per
    --user-data-dir), which is what you want when a link is handed to an
    already-open client session. Launching from the app grid does pass it.
    """
    key = target.get("browser", "chromium")
    spec = BROWSERS.get(key, BROWSERS["chromium"])
    binary = browser_binary(key)
    if not binary:
        die(f"browser {key!r} is configured for target {target['id']!r} but is not installed")

    argv = [binary]
    profile = target.get("profileDir") or ""
    wm_class = target.get("wmClass") or f"{key}-{target['id']}"

    if spec["family"] == "chromium":
        if profile:
            argv.append(f"--user-data-dir={profile}")
        argv.append(f"--class={wm_class}")
        if new_window:
            argv.append("--new-window")
    else:
        if profile:
            argv += ["--profile", profile]
        argv += ["--class", wm_class]
        if new_window:
            argv.append("--new-window")

    argv += list(urls)
    return argv


# --------------------------------------------------------------------------- config

def default_config():
    return {"version": 1, "targets": []}


def load_config():
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return default_config()
    except (OSError, ValueError) as exc:
        die(f"cannot read {CONFIG_FILE}: {exc}")
    if not isinstance(data, dict):
        die(f"{CONFIG_FILE} is not a JSON object")
    data.setdefault("version", 1)
    if not isinstance(data.get("targets"), list):
        data["targets"] = []
    return data


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    write_atomic(CONFIG_FILE, json.dumps(cfg, indent=2) + "\n")


def write_atomic(path, content):
    """Write via a temp file in the same directory, then rename.

    The config file is watched by the running shell plugin; a partial read of
    a half-written file would blank the panel, so the swap has to be atomic.
    """
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".bs-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def find_target(cfg, ident):
    ident = str(ident)
    for t in cfg["targets"]:
        if t["id"] == ident:
            return t
    matches = [t for t in cfg["targets"] if t.get("name", "").lower() == ident.lower()]
    if len(matches) == 1:
        return matches[0]
    return None


def require_target(cfg, ident):
    target = find_target(cfg, ident)
    if not target:
        die(f"no such target: {ident!r} (see `{APP} list`)")
    return target


def slugify(name):
    slug = re.sub(r"[^a-z0-9]+", "-", str(name).strip().lower()).strip("-")
    return slug or "target"


def unique_id(cfg, base):
    existing = {t["id"] for t in cfg["targets"]}
    if base not in existing:
        return base
    n = 2
    while f"{base}-{n}" in existing:
        n += 1
    return f"{base}-{n}"


# --------------------------------------------------------------------------- state

def active_id():
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def set_active(target_id):
    os.makedirs(STATE_DIR, exist_ok=True)
    write_atomic(STATE_FILE, str(target_id) + "\n")


def active_target(cfg):
    ident = active_id()
    if ident:
        found = find_target(cfg, ident)
        if found:
            return found
    return cfg["targets"][0] if cfg["targets"] else None


# --------------------------------------------------------------------------- colors

def norm_color(value, fallback="#8AA2C8"):
    s = str(value or "").strip()
    m = re.match(r"^#?([0-9A-Fa-f]{6})$", s)
    if m:
        return "#" + m.group(1).upper()
    m = re.match(r"^#?([0-9A-Fa-f]{3})$", s)
    if m:
        h = m.group(1)
        return "#" + "".join(c * 2 for c in h).upper()
    # zenity --color-selection hands back rgb(r,g,b) or rgba(...)
    m = re.match(r"^rgba?\((\d+),\s*(\d+),\s*(\d+)", s)
    if m:
        return "#" + "".join(f"{min(255, int(g)):02X}" for g in m.groups())
    return fallback


def hex_digits(color):
    return norm_color(color).lstrip("#")


def dim_hex(color, factor=0.55):
    h = hex_digits(color)
    parts = [int(h[i:i + 2], 16) for i in (0, 2, 4)]
    return "".join(f"{max(0, min(255, int(round(p * factor)))):02X}" for p in parts)


# --------------------------------------------------------------------------- icons

def base_icon_path(browser_key, size):
    """Find the browser's stock icon at `size`, else the biggest one there is."""
    spec = BROWSERS.get(browser_key, BROWSERS["chromium"])
    names = [spec["icon"], browser_key]
    roots = [
        ICON_ROOT,
        "/usr/share/icons/hicolor",
        "/usr/local/share/icons/hicolor",
    ]
    exact, fallbacks = None, []
    for root in roots:
        for name in names:
            for candidate_size in sorted(ICON_SIZES, reverse=True):
                p = os.path.join(root, f"{candidate_size}x{candidate_size}", "apps", f"{name}.png")
                if os.path.isfile(p):
                    if candidate_size == size and exact is None:
                        exact = p
                    fallbacks.append(p)
            svg = os.path.join(root, "scalable", "apps", f"{name}.svg")
            if os.path.isfile(svg):
                fallbacks.append(svg)
    if exact:
        return exact
    for p in ["/usr/share/pixmaps/%s.png" % n for n in names]:
        if os.path.isfile(p):
            fallbacks.append(p)
    return fallbacks[0] if fallbacks else None


def have_magick():
    return shutil.which("magick") or shutil.which("convert")


def magick_argv():
    exe = shutil.which("magick")
    return [exe] if exe else [shutil.which("convert")]


def render_icon(browser_key, badge_png, color, size, out_path):
    """Composite `badge_png` (or a plain colour dot) onto the browser icon.

    The badge is drawn on a filled disc in the client colour, so a target is
    identifiable at 16px even when its logo is illegible at that size, and so
    a target with no logo at all still gets a distinct mark.
    """
    base = base_icon_path(browser_key, size)
    if not base:
        return False

    disc = max(10, int(round(size * 0.55)))
    ring = max(1, int(round(disc * 0.10)))
    inner = max(4, disc - 2 * ring)
    radius = disc / 2.0
    color = norm_color(color)

    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        disc_png = os.path.join(tmp, "disc.png")
        # Filled circle in the client colour = the badge backing plate.
        run_quiet(magick_argv() + [
            "-size", f"{disc}x{disc}", "xc:none",
            "-fill", color, "-draw", f"circle {radius},{radius} {radius},0",
            disc_png,
        ])

        if badge_png and os.path.isfile(badge_png):
            run_quiet(magick_argv() + [
                disc_png,
                "(", badge_png, "-background", "none",
                "-resize", f"{inner}x{inner}",
                "-gravity", "center", "-extent", f"{inner}x{inner}", ")",
                "-gravity", "center", "-compose", "over", "-composite",
                disc_png,
            ])

        return run_quiet(magick_argv() + [
            base, "-background", "none",
            "-resize", f"{size}x{size}",
            "-gravity", "center", "-extent", f"{size}x{size}",
            disc_png, "-gravity", "southeast", "-geometry", "+0+0",
            "-compose", "over", "-composite",
            out_path,
        ])


def run_quiet(argv):
    try:
        proc = subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except OSError as exc:
        warn(f"failed to run {argv[0]}: {exc}")
        return False
    if proc.returncode != 0:
        warn(f"{argv[0]} failed: {proc.stderr.decode('utf-8', 'replace').strip()}")
        return False
    return True


def resolve_icon_path(target):
    """Absolute path to the best icon file for a target, for the shell panel.

    QML draws a file, not an icon-theme name, so the lookup that a desktop
    environment would normally do has to happen here.
    """
    if target.get("managed"):
        name = icon_name(target)
    else:
        name = target.get("icon") or BROWSERS.get(
            target.get("browser", "chromium"), BROWSERS["chromium"])["icon"]

    if os.path.isabs(name) and os.path.isfile(name):
        return name

    roots = [ICON_ROOT, "/usr/share/icons/hicolor", "/usr/local/share/icons/hicolor"]
    for root in roots:
        for size in sorted(ICON_SIZES, reverse=True):
            candidate = os.path.join(root, f"{size}x{size}", "apps", f"{name}.png")
            if os.path.isfile(candidate):
                return candidate
        svg = os.path.join(root, "scalable", "apps", f"{name}.svg")
        if os.path.isfile(svg):
            return svg
    pixmap = f"/usr/share/pixmaps/{name}.png"
    return pixmap if os.path.isfile(pixmap) else ""


def icon_name(target):
    return f"browser-switcher-{target['id']}"


def desktop_filename(target):
    return f"browser-switcher-{target['id']}.desktop"


# --------------------------------------------------------------------------- generation

def generate_icons(target):
    if not have_magick():
        warn("ImageMagick not found — skipping icon badging (install `imagemagick`)")
        return False
    name = icon_name(target)
    ok = False
    for size in ICON_SIZES:
        out = os.path.join(ICON_ROOT, f"{size}x{size}", "apps", f"{name}.png")
        if render_icon(target.get("browser", "chromium"), target.get("badge"), target.get("color"), size, out):
            ok = True
    return ok


def self_path():
    """The path to write into generated Exec= lines.

    Prefer the stable ~/.local/bin entry over whatever path this process
    happens to have been started from, so entries keep working if the git
    checkout is later moved or renamed.
    """
    installed = os.path.join(HOME, ".local", "bin", APP)
    if os.path.isfile(installed):
        return installed
    return shutil.which(APP) or os.path.abspath(sys.argv[0])


def generate_desktop(target):
    key = target.get("browser", "chromium")
    spec = BROWSERS.get(key, BROWSERS["chromium"])
    icon = icon_name(target) if icon_exists(icon_name(target)) else spec["icon"]
    body = f"""[Desktop Entry]
# {GENERATED_BANNER}
Type=Application
Version=1.0
Name={spec['name']} — {target['name']}
GenericName=Web Browser
Comment={spec['name']} running the isolated {target['name']} profile
Exec={shlex.quote(self_path())} launch {shlex.quote(target['id'])} %U
Icon={icon}
Terminal=false
StartupNotify=true
StartupWMClass={target.get('wmClass', key + '-' + target['id'])}
Categories=Network;WebBrowser;
Keywords={key};browser;client;profile;{target['id']};
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
"""
    write_atomic(os.path.join(APPS_DIR, desktop_filename(target)), body)


def icon_exists(name):
    return any(
        os.path.isfile(os.path.join(ICON_ROOT, f"{s}x{s}", "apps", f"{name}.png"))
        for s in ICON_SIZES
    )


def generate_router_desktop():
    body = f"""[Desktop Entry]
# {GENERATED_BANNER}
Type=Application
Version=1.0
Name=Browser Switcher
GenericName=Web Browser
Comment=Opens links in whichever browser profile is currently selected
Exec={shlex.quote(self_path())} open %U
Icon=browser-switcher
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
"""
    write_atomic(ROUTER_DESKTOP, body)


SAFE_CLASS_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def lua_regex_class(wm_class):
    r"""Return `wm_class` as a regex fragment safe inside a Lua string, or None.

    Two constraints stack here. Hyprland matches classes with a POSIX regex,
    but the pattern is written inside a Lua string literal, and Lua rejects
    unknown escapes like `\-` outright — a backslash-escaped pattern would
    make the whole config fail to parse. So instead of escaping, we restrict
    to characters that need no escaping and express `.` as the bracket class
    `[.]`, which is literal in regex and backslash-free in Lua.
    """
    value = str(wm_class or "")
    if not SAFE_CLASS_RE.match(value):
        return None
    return value.replace(".", "[.]")


def sanitize_wm_class(value):
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", str(value or "")).strip("-")
    return cleaned or "browser"


def generate_hypr_rules(cfg):
    """Emit Hyprland window rules for managed targets only.

    Adopted targets are skipped on purpose: the user already has rules for
    them somewhere, and two `o.window` rules for one class would fight over
    the border colour depending on require order.
    """
    managed = [t for t in cfg["targets"] if t.get("managed") and t.get("wmClass")]
    lines = [
        f"-- {GENERATED_BANNER}",
        "--",
        "-- Per-client browser windows get their client's brand colour as the",
        "-- window border, so which session a window belongs to is obvious",
        "-- without reading the tab strip.",
        "",
    ]
    safe = [t for t in managed if lua_regex_class(t["wmClass"])]
    for t in managed:
        if not lua_regex_class(t["wmClass"]):
            warn(f"skipping Hyprland rule for {t['id']}: window class "
                 f"{t['wmClass']!r} has characters that cannot be embedded safely")
    managed = safe

    if not managed:
        lines.append("-- No managed targets yet.")
    else:
        classes = "|".join(lua_regex_class(t["wmClass"]) for t in managed)
        lines += [
            "-- Parity with Omarchy's chromium-based-browser rule: match:class is a",
            "-- full-match regex, so these custom classes miss the default browser",
            "-- rule and would otherwise fall back to generic window opacity.",
            f'o.window("({classes})", {{',
            '  tag = "-default-opacity",',
            "  tile = true,",
            '  opacity = "1.0 0.985",',
            "})",
            "",
            "-- Client identity colours: active border, then a dimmed inactive one",
            "-- so an unfocused window still shows which client it belongs to.",
        ]
        for t in managed:
            active = hex_digits(t.get("color"))
            inactive = dim_hex(t.get("color"))
            lines.append(
                f'o.window("{t["wmClass"]}", {{ border_color = "rgb({active}) rgb({inactive})" }})'
            )
    write_atomic(HYPR_RULES, "\n".join(lines) + "\n")


def refresh_desktop_database():
    if shutil.which("update-desktop-database"):
        run_quiet([shutil.which("update-desktop-database"), APPS_DIR])
    # Skip the icon cache unless the theme dir is a real one; gtk-update-icon-cache
    # errors out on a bare directory with no index.theme, which is only noise.
    if shutil.which("gtk-update-icon-cache") and os.path.isfile(os.path.join(ICON_ROOT, "index.theme")):
        run_quiet([shutil.which("gtk-update-icon-cache"), "-f", "-t", ICON_ROOT])


def apply_all(cfg, quiet=False):
    generate_router_desktop()
    for target in cfg["targets"]:
        if target.get("managed"):
            generate_icons(target)
            generate_desktop(target)
    generate_hypr_rules(cfg)
    refresh_desktop_database()
    if not quiet:
        info(f"applied {len(cfg['targets'])} target(s)")


# --------------------------------------------------------------------------- output

def die(msg, code=1):
    print(f"{APP}: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"{APP}: warning: {msg}", file=sys.stderr)


def info(msg):
    print(f"{APP}: {msg}")


def notify(title, body, icon=None):
    exe = shutil.which("notify-send")
    if not exe:
        return
    argv = [exe, "-a", "Browser Switcher"]
    if icon:
        argv += ["-i", icon]
    argv += [title, body]
    subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --------------------------------------------------------------------------- commands

def cmd_open(args):
    cfg = load_config()
    target = active_target(cfg)
    if not target:
        # Never swallow a link: with nothing configured, fall through to a
        # real browser rather than dropping the URL on the floor.
        for key in ("chromium", "firefox", "google-chrome", "brave"):
            binary = browser_binary(key)
            if binary:
                warn("no targets configured — falling back to " + key)
                os.execv(binary, [binary] + list(args.urls))
        die("no targets configured and no browser found")
    argv = launch_argv(target, args.urls, new_window=False)
    os.execv(argv[0], argv)


def cmd_launch(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    argv = launch_argv(target, args.urls, new_window=True)
    os.execv(argv[0], argv)


def cmd_use(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    set_active(target["id"])
    if not args.quiet:
        info(f"links now open in {target['name']}")
    if args.notify:
        notify("Browser switched", f"Links now open in {target['name']}", icon_name(target))


def cmd_status(args):
    cfg = load_config()
    target = active_target(cfg)
    if args.json:
        print(json.dumps({
            "active": target["id"] if target else None,
            "activeName": target["name"] if target else None,
            "installed": os.path.isfile(ROUTER_DESKTOP),
            "isDefault": is_default_browser(),
        }, indent=2))
        return
    if not target:
        print("no targets configured")
        return
    print(f"{target['name']} ({target['id']})")


def cmd_list(args):
    cfg = load_config()
    current = active_target(cfg)
    if args.json:
        enriched = []
        for t in cfg["targets"]:
            row = dict(t)
            row["iconPath"] = resolve_icon_path(t)
            row["available"] = bool(browser_binary(t.get("browser", "chromium")))
            enriched.append(row)
        print(json.dumps({
            "active": current["id"] if current else None,
            "targets": enriched,
            "browsers": installed_browsers(),
            "installed": os.path.isfile(ROUTER_DESKTOP),
            "isDefault": is_default_browser(),
        }, indent=2))
        return
    if not cfg["targets"]:
        print("no targets configured — add one with `browser-switcher add --name NAME`")
        return
    for t in cfg["targets"]:
        mark = "*" if current and t["id"] == current["id"] else " "
        kind = "managed" if t.get("managed") else "adopted"
        print(f" {mark} {t['id']:<18} {t['name']:<22} {t.get('browser','chromium'):<14} "
              f"{norm_color(t.get('color')):<8} {kind}")


def cmd_browsers(args):
    found = installed_browsers()
    if args.json:
        print(json.dumps(found, indent=2))
        return
    for b in found:
        print(f"{b['id']:<16} {b['name']:<18} {b['binary']}")


def cmd_add(args):
    cfg = load_config()
    name = args.name.strip()
    if not name:
        die("--name must not be empty")
    browser = args.browser
    if browser not in BROWSERS:
        die(f"unknown browser {browser!r} (see `{APP} browsers`)")
    if not browser_binary(browser):
        warn(f"{browser} is not installed right now; adding the target anyway")

    target_id = unique_id(cfg, slugify(args.id or name))
    wm_class = sanitize_wm_class(args.wm_class or f"{browser}-{target_id}")

    # Refuse to shadow a hand-made setup. A duplicate WM class would make the
    # user's own window rules and ours both match, and the loser is decided by
    # require order — a confusing failure to debug later.
    clash = existing_wm_class_owner(cfg, wm_class)
    if clash and not args.force:
        die(f"window class {wm_class!r} is already used by {clash}.\n"
            f"  Use `{APP} adopt` to bring that setup in as-is, or pass "
            f"--wm-class to pick another class.")

    profile_dir = args.profile_dir or os.path.join(PROFILE_ROOT, target_id)
    badge = None
    if args.icon:
        badge = store_badge(target_id, args.icon)

    target = {
        "id": target_id,
        "name": name,
        "browser": browser,
        "profileDir": profile_dir,
        "wmClass": wm_class,
        "color": norm_color(args.color),
        "badge": badge,
        "managed": True,
    }
    cfg["targets"].append(target)
    save_config(cfg)
    os.makedirs(profile_dir, exist_ok=True)
    apply_all(cfg, quiet=True)
    if not active_id():
        set_active(target_id)
    info(f"added {name} ({target_id})")


def existing_wm_class_owner(cfg, wm_class):
    for t in cfg["targets"]:
        if t.get("wmClass") == wm_class:
            return f"target {t['id']!r}"
    # Scan hand-made desktop entries too — this is exactly the collision the
    # user warned about between their manual setup and generated files.
    for directory in (APPS_DIR, "/usr/share/applications"):
        try:
            entries = os.listdir(directory)
        except OSError:
            continue
        for entry in entries:
            if not entry.endswith(".desktop") or entry.startswith("browser-switcher-"):
                continue
            path = os.path.join(directory, entry)
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as fh:
                    content = fh.read()
            except OSError:
                continue
            if re.search(r"^StartupWMClass=%s\s*$" % re.escape(wm_class), content, re.M):
                return f"the existing desktop entry {entry}"
    return None


def store_badge(target_id, source):
    source = os.path.expanduser(source)
    if not os.path.isfile(source):
        die(f"icon file not found: {source}")
    os.makedirs(BADGE_DIR, exist_ok=True)
    dest = os.path.join(BADGE_DIR, f"{target_id}.png")
    if not have_magick():
        shutil.copyfile(source, dest)
        return dest
    # Normalise whatever was handed to us (svg, jpg, huge png) to one square
    # transparent PNG, so re-badging later never has to touch the original.
    if not run_quiet(magick_argv() + [
        source, "-background", "none", "-resize", "256x256",
        "-gravity", "center", "-extent", "256x256", dest,
    ]):
        die(f"could not convert {source} into a badge image")
    return dest


def cmd_remove(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    cfg["targets"] = [t for t in cfg["targets"] if t["id"] != target["id"]]
    save_config(cfg)

    if target.get("managed"):
        remove_quiet(os.path.join(APPS_DIR, desktop_filename(target)))
        for size in ICON_SIZES:
            remove_quiet(os.path.join(ICON_ROOT, f"{size}x{size}", "apps", f"{icon_name(target)}.png"))
        remove_quiet(target.get("badge"))
    else:
        info(f"{target['id']} was adopted, not generated — its desktop entry and icon are left in place")

    if args.purge and target.get("profileDir", "").startswith(PROFILE_ROOT):
        shutil.rmtree(target["profileDir"], ignore_errors=True)
        info(f"deleted profile data at {target['profileDir']}")

    if active_id() == target["id"]:
        remaining = cfg["targets"]
        if remaining:
            set_active(remaining[0]["id"])
        else:
            remove_quiet(STATE_FILE)

    apply_all(cfg, quiet=True)
    info(f"removed {target['name']} ({target['id']})")


def remove_quiet(path):
    if not path:
        return
    try:
        os.unlink(path)
    except OSError:
        pass


def cmd_rename(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    new_name = args.new_name.strip()
    if not new_name:
        die("new name must not be empty")
    target["name"] = new_name
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"renamed {target['id']} to {new_name}")


def cmd_set(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    changed = []
    if args.name:
        target["name"] = args.name.strip()
        changed.append("name")
    if args.color:
        target["color"] = norm_color(args.color)
        changed.append("color")
    if args.icon:
        target["badge"] = store_badge(target["id"], args.icon)
        changed.append("icon")
    if args.browser:
        if args.browser not in BROWSERS:
            die(f"unknown browser {args.browser!r}")
        target["browser"] = args.browser
        changed.append("browser")
    if args.profile_dir:
        target["profileDir"] = os.path.expanduser(args.profile_dir)
        changed.append("profile")
    if not changed:
        die("nothing to change — pass at least one of --name/--color/--icon/--browser/--profile-dir")
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"updated {target['id']}: {', '.join(changed)}")


def cmd_reorder(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    targets = cfg["targets"]
    index = targets.index(target)
    new_index = max(0, min(len(targets) - 1, index + (-1 if args.direction == "up" else 1)))
    targets.insert(new_index, targets.pop(index))
    save_config(cfg)
    info(f"moved {target['id']} {args.direction}")


def cmd_pick_icon(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    exe = shutil.which("zenity")
    if not exe:
        die("zenity is not installed; pass a path with `set --icon PATH` instead")
    proc = subprocess.run(
        [exe, "--file-selection", "--title", f"Choose a logo for {target['name']}",
         "--file-filter=Images | *.png *.jpg *.jpeg *.svg *.webp *.ico"],
        capture_output=True, text=True)
    path = proc.stdout.strip()
    if proc.returncode != 0 or not path:
        return
    target["badge"] = store_badge(target["id"], path)
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"icon updated for {target['id']}")


def cmd_pick_color(args):
    cfg = load_config()
    target = require_target(cfg, args.target)
    exe = shutil.which("zenity")
    if not exe:
        die("zenity is not installed; pass a value with `set --color '#RRGGBB'` instead")
    proc = subprocess.run(
        [exe, "--color-selection", "--show-palette",
         "--title", f"Colour for {target['name']}",
         "--color", norm_color(target.get("color"))],
        capture_output=True, text=True)
    value = proc.stdout.strip()
    if proc.returncode != 0 or not value:
        return
    target["color"] = norm_color(value, target.get("color"))
    save_config(cfg)
    apply_all(cfg, quiet=True)
    info(f"colour updated for {target['id']}")


# --------------------------------------------------------------------------- adopt

def parse_desktop(path):
    fields = {}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            in_entry = False
            for line in fh:
                line = line.strip()
                if line.startswith("["):
                    in_entry = line == "[Desktop Entry]"
                    continue
                if not in_entry or "=" not in line or line.startswith("#"):
                    continue
                key, _, value = line.partition("=")
                fields.setdefault(key.strip(), value.strip())
    except OSError:
        return None
    return fields


def discover_candidates(cfg):
    """Find hand-made per-profile browser launchers not yet in the config.

    The tell is a browser Exec that pins an isolated profile directory —
    that is what makes an entry a *client session* rather than just another
    way to start the browser.
    """
    known_desktops = {t.get("desktopFile") for t in cfg["targets"]}
    known_classes = {t.get("wmClass") for t in cfg["targets"]}
    found = []
    try:
        entries = sorted(os.listdir(APPS_DIR))
    except OSError:
        return found

    for entry in entries:
        if not entry.endswith(".desktop") or entry.startswith("browser-switcher"):
            continue
        path = os.path.join(APPS_DIR, entry)
        fields = parse_desktop(path)
        if not fields or fields.get("Type") != "Application":
            continue
        exec_line = fields.get("Exec", "")
        wm_class = fields.get("StartupWMClass", "")
        if entry in known_desktops or (wm_class and wm_class in known_classes):
            continue

        browser, profile = infer_from_exec(exec_line)
        if not browser:
            continue
        if not profile and not wm_class:
            continue

        found.append({
            "desktopFile": entry,
            "path": path,
            "name": fields.get("Name", entry[:-8]),
            "browser": browser,
            "profileDir": profile,
            "wmClass": wm_class,
            "icon": fields.get("Icon", ""),
            "exec": exec_line,
        })
    return found


def infer_from_exec(exec_line):
    """Work out (browser, profile dir) from an Exec line.

    Handles both a direct browser invocation and the common wrapper-script
    shape (`~/.local/bin/chromium-client acme`), where the profile path only
    exists inside the script — so we read the script too.
    """
    try:
        parts = shlex.split(exec_line)
    except ValueError:
        parts = exec_line.split()
    if not parts:
        return None, ""

    browser = None
    profile = ""
    program = os.path.basename(parts[0])

    for key, spec in BROWSERS.items():
        if program in spec["commands"] or program == key:
            browser = key
            break

    for i, part in enumerate(parts[1:], start=1):
        if part.startswith("--user-data-dir="):
            profile = os.path.expanduser(part.split("=", 1)[1])
        elif part == "--user-data-dir" and i + 1 < len(parts):
            profile = os.path.expanduser(parts[i + 1])
        elif part == "--profile" and i + 1 < len(parts):
            profile = os.path.expanduser(parts[i + 1])

    if browser:
        return browser, profile

    # Wrapper script: resolve it and look inside.
    script = os.path.expanduser(parts[0])
    if not os.path.isabs(script):
        script = shutil.which(parts[0]) or script
    if not os.path.isfile(script):
        return None, ""
    try:
        with open(script, "r", encoding="utf-8", errors="replace") as fh:
            body = fh.read()
    except OSError:
        return None, ""
    if len(body) > 64000:
        return None, ""

    for key, spec in BROWSERS.items():
        for command in spec["commands"] + [key]:
            if re.search(r"(^|[\s\"'=/])%s(\s|$|\")" % re.escape(command), body, re.M):
                browser = key
                break
        if browser:
            break
    if not browser:
        return None, ""

    match = re.search(r'--user-data-dir=(?:"|\')?([^"\'\s]+)', body)
    if match:
        raw = match.group(1)
        arg = parts[1] if len(parts) > 1 else ""
        # Expand the shell in the narrow way these wrappers actually use it.
        raw = raw.replace("$HOME", HOME).replace("${HOME}", HOME)
        raw = raw.replace('$CLIENT', arg).replace('${CLIENT}', arg)
        raw = raw.replace('$1', arg)
        if "$" not in raw:
            profile = os.path.expanduser(raw)
    return browser, profile


def cmd_discover(args):
    cfg = load_config()
    candidates = discover_candidates(cfg)
    if args.json:
        print(json.dumps(candidates, indent=2))
        return
    if not candidates:
        print("no unregistered browser profile launchers found")
        return
    for c in candidates:
        print(f"{c['desktopFile']:<34} {c['name']:<24} {c['browser']:<12} {c['profileDir']}")


def existing_border_color(wm_class):
    """Recover the colour a hand-written Hyprland rule already uses for a class.

    Adopting should not silently repaint a client that already has an agreed
    brand colour, so we read it back out of the user's own config rather than
    assigning a default.
    """
    if not wm_class:
        return None
    pattern = re.compile(
        r'o\.window\(\s*"' + re.escape(wm_class) +
        r'"\s*,\s*\{[^}]*border_color\s*=\s*"\s*rgba?\(([0-9A-Fa-f]{6})',
        re.S)
    try:
        names = sorted(os.listdir(HYPR_DIR))
    except OSError:
        return None
    for name in names:
        if not name.endswith(".lua") or name == "browser-switcher.lua":
            continue
        try:
            with open(os.path.join(HYPR_DIR, name), "r", encoding="utf-8", errors="replace") as fh:
                match = pattern.search(fh.read())
        except OSError:
            continue
        if match:
            return "#" + match.group(1).upper()
    return None


def cmd_adopt(args):
    """Register an existing hand-made launcher without rewriting a byte of it.

    Adopted targets are marked `managed: false`, which makes every generator
    in this program skip them: no desktop entry is written, no icon is
    re-badged, no Hyprland rule is emitted. The switcher just learns how to
    launch them.
    """
    cfg = load_config()
    candidates = discover_candidates(cfg)
    by_file = {c["desktopFile"]: c for c in candidates}

    if args.desktop_file:
        wanted = [args.desktop_file if args.desktop_file.endswith(".desktop")
                  else args.desktop_file + ".desktop"]
    else:
        wanted = list(by_file.keys())
    if not wanted:
        info("nothing to adopt")
        return

    adopted = []
    for filename in wanted:
        candidate = by_file.get(filename)
        if not candidate:
            warn(f"{filename} is not an adoptable launcher (already registered, or not a profile launcher)")
            continue
        name = args.name if (args.name and len(wanted) == 1) else candidate["name"]
        # "Chromium — acme" is a fine desktop-entry name but a poor menu row;
        # the distinguishing half is what belongs in the switcher.
        short = re.split(r"\s+[—–-]\s+", name)
        display = short[-1].strip() if len(short) > 1 else name
        target_id = unique_id(cfg, slugify(candidate["wmClass"].split("-")[-1] or display))
        cfg["targets"].append({
            "id": target_id,
            "name": display,
            "browser": candidate["browser"],
            "profileDir": candidate["profileDir"],
            "wmClass": candidate["wmClass"],
            "color": norm_color(args.color if args.color != "#8AA2C8"
                                else existing_border_color(candidate["wmClass"]) or args.color,
                                "#8AA2C8"),
            "badge": None,
            "icon": candidate["icon"] or None,
            "desktopFile": candidate["desktopFile"],
            "managed": False,
        })
        adopted.append(display)

    if not adopted:
        return
    save_config(cfg)
    if not active_id():
        set_active(cfg["targets"][0]["id"])
    apply_all(cfg, quiet=True)
    info("adopted: " + ", ".join(adopted))
    info("these are marked unmanaged — their desktop entries, icons and window rules are left untouched")


# --------------------------------------------------------------------------- install

def is_default_browser():
    exe = shutil.which("xdg-settings")
    if not exe:
        return False
    try:
        proc = subprocess.run([exe, "get", "default-web-browser"],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.stdout.strip() == "browser-switcher.desktop"


def previous_default_file():
    return os.path.join(STATE_DIR, "previous-default-browser")


def cmd_install(args):
    cfg = load_config()
    generate_router_desktop()

    if args.set_default:
        exe = shutil.which("xdg-settings")
        if not exe:
            warn("xdg-settings not found — set the default browser manually")
        else:
            current = subprocess.run([exe, "get", "default-web-browser"],
                                     capture_output=True, text=True).stdout.strip()
            # Remember what was there so `uninstall` can put it back rather
            # than leaving the system with no default browser at all.
            if current and current != "browser-switcher.desktop":
                os.makedirs(STATE_DIR, exist_ok=True)
                write_atomic(previous_default_file(), current + "\n")
            proc = subprocess.run([exe, "set", "default-web-browser", "browser-switcher.desktop"],
                                  capture_output=True, text=True)
            if proc.returncode != 0:
                warn(f"could not set default browser: {proc.stderr.strip()}")
            else:
                info("browser-switcher.desktop is now the default web browser")

    if args.hyprland:
        wire_hyprland()

    apply_all(cfg, quiet=True)
    info("installed")
    if not args.set_default:
        info("run with --set-default to route links here, or set 'Browser Switcher' "
             "as your default browser manually")


def wire_hyprland():
    """Append the require line to hyprland.lua, once, with a backup."""
    if not os.path.isfile(HYPR_MAIN):
        warn(f"{HYPR_MAIN} not found — skipping Hyprland wiring")
        return
    try:
        with open(HYPR_MAIN, "r", encoding="utf-8") as fh:
            content = fh.read()
    except OSError as exc:
        warn(f"cannot read {HYPR_MAIN}: {exc}")
        return
    if HYPR_REQUIRE in content:
        return
    shutil.copyfile(HYPR_MAIN, HYPR_MAIN + ".bak.browser-switcher")
    addition = (
        "\n-- Added by browser-switcher: per-client browser window borders.\n"
        "-- Loaded last so it wins over earlier rules for the same classes.\n"
        f"{HYPR_REQUIRE}\n"
    )
    with open(HYPR_MAIN, "a", encoding="utf-8") as fh:
        fh.write(addition)
    info(f"added {HYPR_REQUIRE} to {HYPR_MAIN} (backup: {os.path.basename(HYPR_MAIN)}.bak.browser-switcher)")


def cmd_uninstall(args):
    cfg = load_config()

    if is_default_browser():
        exe = shutil.which("xdg-settings")
        restore = None
        try:
            with open(previous_default_file(), "r", encoding="utf-8") as fh:
                restore = fh.read().strip()
        except OSError:
            pass
        if exe and restore:
            subprocess.run([exe, "set", "default-web-browser", restore],
                           capture_output=True, text=True)
            info(f"restored {restore} as the default browser")
        else:
            warn("was the default browser — set a new default manually")

    remove_quiet(ROUTER_DESKTOP)
    for target in cfg["targets"]:
        if target.get("managed"):
            remove_quiet(os.path.join(APPS_DIR, desktop_filename(target)))
            for size in ICON_SIZES:
                remove_quiet(os.path.join(ICON_ROOT, f"{size}x{size}", "apps",
                                          f"{icon_name(target)}.png"))
    remove_quiet(HYPR_RULES)

    if os.path.isfile(HYPR_MAIN):
        try:
            with open(HYPR_MAIN, "r", encoding="utf-8") as fh:
                lines = fh.readlines()
            kept = [ln for ln in lines
                    if HYPR_REQUIRE not in ln and "Added by browser-switcher" not in ln
                    and "Loaded last so it wins" not in ln]
            if len(kept) != len(lines):
                write_atomic(HYPR_MAIN, "".join(kept))
                info(f"removed the browser-switcher require from {HYPR_MAIN}")
        except OSError:
            pass

    refresh_desktop_database()
    info("uninstalled — config kept at " + CONFIG_FILE)
    if args.purge:
        shutil.rmtree(CONFIG_DIR, ignore_errors=True)
        shutil.rmtree(DATA_DIR, ignore_errors=True)
        shutil.rmtree(STATE_DIR, ignore_errors=True)
        info("purged configuration and badges")


def cmd_apply(args):
    apply_all(load_config())


def cmd_doctor(args):
    cfg = load_config()
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        if not good:
            ok = False
        print(f"  [{'ok' if good else 'FAIL'}] {label}" + (f" — {detail}" if detail else ""))

    print("browser-switcher doctor\n")
    check("ImageMagick available", bool(have_magick()), "needed for badged icons")
    check("router desktop entry installed", os.path.isfile(ROUTER_DESKTOP), ROUTER_DESKTOP)
    check("is the default web browser", is_default_browser(),
          "run `browser-switcher install --set-default`")
    check("targets configured", bool(cfg["targets"]), f"{len(cfg['targets'])} found")

    current = active_target(cfg)
    check("an active target is selected", current is not None,
          current["name"] if current else "none")

    for target in cfg["targets"]:
        binary = browser_binary(target.get("browser", "chromium"))
        check(f"target {target['id']}: browser installed", bool(binary),
              target.get("browser", "chromium"))
        profile = target.get("profileDir")
        if profile:
            check(f"target {target['id']}: profile dir exists", os.path.isdir(profile), profile)
        if target.get("managed"):
            entry = os.path.join(APPS_DIR, desktop_filename(target))
            check(f"target {target['id']}: desktop entry", os.path.isfile(entry), entry)
            check(f"target {target['id']}: badged icon", icon_exists(icon_name(target)))

    if os.path.isfile(HYPR_MAIN):
        try:
            with open(HYPR_MAIN, "r", encoding="utf-8") as fh:
                wired = HYPR_REQUIRE in fh.read()
        except OSError:
            wired = False
        check("hyprland.lua requires the generated rules", wired,
              f"add {HYPR_REQUIRE}")
        check("generated Hyprland rules exist", os.path.isfile(HYPR_RULES), HYPR_RULES)

    print()
    sys.exit(0 if ok else 1)


# --------------------------------------------------------------------------- cli

def build_parser():
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Route opened URLs to a chosen browser or client profile.")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("open", help="open URLs in the active target (the router)")
    p.add_argument("urls", nargs="*")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("launch", help="open a new window of a specific target")
    p.add_argument("target")
    p.add_argument("urls", nargs="*")
    p.set_defaults(func=cmd_launch)

    p = sub.add_parser("use", help="make a target the active link destination")
    p.add_argument("target")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--notify", action="store_true", help="show a desktop notification")
    p.set_defaults(func=cmd_use)

    p = sub.add_parser("status", help="show the active target")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("list", help="list configured targets")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("browsers", help="list installed browsers")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_browsers)

    p = sub.add_parser("add", help="create a new client target")
    p.add_argument("--name", required=True)
    p.add_argument("--id", help="explicit slug (default: derived from the name)")
    p.add_argument("--browser", default="chromium")
    p.add_argument("--color", default="#8AA2C8")
    p.add_argument("--icon", help="path to a logo image to badge onto the browser icon")
    p.add_argument("--profile-dir")
    p.add_argument("--wm-class")
    p.add_argument("--force", action="store_true", help="add even if the window class clashes")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("remove", help="delete a target")
    p.add_argument("target")
    p.add_argument("--purge", action="store_true", help="also delete its browser profile data")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("rename", help="rename a target")
    p.add_argument("target")
    p.add_argument("new_name")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("set", help="change a target's properties")
    p.add_argument("target")
    p.add_argument("--name")
    p.add_argument("--color")
    p.add_argument("--icon")
    p.add_argument("--browser")
    p.add_argument("--profile-dir")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("reorder", help="move a target up or down the list")
    p.add_argument("target")
    p.add_argument("direction", choices=["up", "down"])
    p.set_defaults(func=cmd_reorder)

    p = sub.add_parser("pick-icon", help="choose a logo with a file dialog")
    p.add_argument("target")
    p.set_defaults(func=cmd_pick_icon)

    p = sub.add_parser("pick-color", help="choose a colour with a colour dialog")
    p.add_argument("target")
    p.set_defaults(func=cmd_pick_color)

    p = sub.add_parser("discover", help="find hand-made profile launchers not yet registered")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_discover)

    p = sub.add_parser("adopt", help="register an existing launcher without modifying it")
    p.add_argument("desktop_file", nargs="?", help="default: adopt everything discoverable")
    p.add_argument("--name")
    p.add_argument("--color", default="#8AA2C8")
    p.set_defaults(func=cmd_adopt)

    p = sub.add_parser("install", help="install the router and register it")
    p.add_argument("--set-default", action="store_true",
                   help="make browser-switcher the default web browser")
    p.add_argument("--hyprland", action="store_true",
                   help="add the generated window rules to hyprland.lua")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="remove generated files and restore the previous default")
    p.add_argument("--purge", action="store_true", help="also delete config and badges")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("apply", help="regenerate every desktop entry, icon and window rule")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("doctor", help="check the installation")
    p.set_defaults(func=cmd_doctor)

    return parser


def main():
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
